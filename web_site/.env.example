# e-isa kurumsal site — ortam değişkenleri (CONTRACT §1)
# Lokal geliştirme için .env.local olarak kopyalayın. Hepsinin lokal varsayılanı vardır;
# yalnızca değiştirmek istediklerinizi yazmanız yeterli.

# Sunucu tarafı fetch tabanı (Django API). K8s: http://eisa-api.eisa-app.svc.cluster.local
API_INTERNAL_URL=http://localhost:8000

# Medya `yol` alanının önüne eklenir (tarayıcı + next/image). Prod: https://api.eisa.com.tr
MEDIA_BASE_URL=http://localhost:8000

# Canonical, sitemap, Open Graph, JSON-LD için sitenin kendi adresi. Prod: https://eisa.com.tr
SITE_URL=http://localhost:3000

# Backend → site revalidate webhook'u için ortak sır (backend ile AYNI değer)
REVALIDATE_SECRET=dev-revalidate-secret

# Site sunucusunun API'ye "ben siteyim" demesi için (X-Website-Token; backend ile AYNI değer)
WEBSITE_SERVER_TOKEN=dev-website-token

# 1 → API yerine src/lib/mock fixture'ları kullanılır (backend gerekmez). Boş/0 → gerçek API.
MOCK_API=

# Opsiyonel: build/dev çıktı dizini (paralel `next dev` için, ör. .next-ajan1). Varsayılan .next
# NEXT_DIST_DIR=
