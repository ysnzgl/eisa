4c:T5f9,{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{"@type":"Question","name":"Kiosk iş yerime sığar mı?","acceptedAnswer":{"@type":"Answer","text":"Samsung kiosk'un kompakt yapısı, standart bir dergilikten fazla alan kaplamadan eczane ortamına yerleşebilecek şekilde tasarlanmıştır."}},{"@type":"Question","name":"Müşteriler kiosku kullanır mı?","acceptedAnswer":{"@type":"Answer","text":"Yalın seçenekler, kısa etkileşim süresi ve dikkat çekici arayüz sayesinde kişinin bekleme anında ekranla etkileşime girmesi hedeflenir. Pilot süreç, bunu kendi eczanenizde gözlemlemenizi sağlar."}},{"@type":"Question","name":"Biz zaten satış yapıyoruz, neden e-isa?","acceptedAnswer":{"@type":"Answer","text":"e-isa, ihtiyacını dile getirmeyen sessiz müşteriyi farkındalık sürecine dahil eder ve eczacının danışmanlığını destekler. Satışı ve son kararı yine eczacı verir."}},{"@type":"Question","name":"İçerikler eczacılık etiğine uygun mu?","acceptedAnswer":{"@type":"Answer","text":"Kiosk'ta yayınlanan içerikler eczane atmosferine ve ilgili sağlık beyanı kurallarına uygunluk açısından denetlenir. e-isa teşhis koymaz, tedavi önermez ve marka yönlendirmesi yapmaz."}},{"@type":"Question","name":"İnternet bağlantısı kesilirse ne olur?","acceptedAnswer":{"@type":"Answer","text":"Sistem çevrimdışı çalışabilecek şekilde tasarlanmıştır. Bağlantı geri geldiğinde veriler, kayıp yaşanmaması gözetilerek yeniden senkronize edilir."}}]}29:["$","div","b_40",{"id":"sss","data-blok-tip":"sss","data-ilk-blok":"$undefined","children":["$","section",null,{"id":"$undefined","data-zemin":"acik","className":"relative isolate bg-bg text-zemin-metin py-20 md:py-28","aria-labelledby":"b_40-baslik","children":["$","div",null,{"className":"container-eisa max-w-7xl","children":[["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$4c"}}],["$","div",null,{"className":"grid gap-10 lg:grid-cols-12 lg:gap-16","children":[["$","div",null,{"className":"lg:col-span-4","